{
  "manifest_version": 3,
  "name": "Next Minute Auto Trader",
  "version": "1.3.1",
  "key": "",
  "description": "Trades the Next Minute HIGHER/LOWER signal on the IQ Option asset you select (Binary, Blitz and Digital options). Practice account by default.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Next Minute Auto Trader: show / hide the panel (starts it again after Exit)",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://iqoption.com/traderoom*"],
      "js": ["src/page-hooks.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://iqoption.com/traderoom*"],
      "js": ["src/signal-engine.js", "src/iq-client.js", "src/trader.js", "src/learner.js", "src/new-option.js",
        "src/lua-scripts.js", "src/chart-script.js", "src/panel.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
